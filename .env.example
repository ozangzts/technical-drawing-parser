# Copy this file to `.env` for local configuration.
# The default settings do not call any paid external API.

TDP_EXTRACTOR=none
TDP_MODEL=

# Local Ollama example:
# TDP_EXTRACTOR=ollama
# TDP_MODEL=gemma4:cloud

# Anthropic Claude example:
# TDP_EXTRACTOR=anthropic
# TDP_MODEL=<claude-model>

# Required only when the Anthropic extractor is enabled.
# Anthropic API usage may incur costs. Do not commit real secrets.
ANTHROPIC_API_KEY=
